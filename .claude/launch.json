{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "todo-calendar",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "todo-calendar-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3001"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "desktop-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "out-desktop", "-l", "4173"],
      "port": 4173
    }
  ]
}
