generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

generator devClient {
  provider = "prisma-client-js"
  output   = "../src/generated/dev-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String?         @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  refreshToken  RefreshToken[]

  createdCategories Category[] @relation("CreatedCategories")
  participatingCategories Category[] @relation("CategoryParticipants")
  settings                UserSettings?

  dailyTasks  DailyTask[]
  dailyMemos  DailyMemo[]

  assignedProjects Project[]     @relation("ProjectAssignees")
  assignedTasks    ProjectTask[] @relation("TaskAssignees")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model UserSettings {
  id    String @id @default(cuid())
  theme String @default("celestial")

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model RefreshToken {
  id           String   @id @default(cuid())
  Token        String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id            String  @id @default(cuid())
  name          String
  color         String
  description   String?

  creator       User    @relation("CreatedCategories", fields: [creatorId], references: [id])
  creatorId     String
  creatorName   String

  participants  User[] @relation("CategoryParticipants")

  todos Todo[]
  projects Project[]
  challenges Challenge[]
}

model Todo {
  id        String    @id @default(cuid())
  title     String
  memo      String?
  startAt   DateTime?
  endAt     DateTime?
  isAllDay  Boolean   @default(false)
  location  String?
  repeat    Int       @default(0)

  repeatEndDate DateTime?
  repeatCount   Int?
  excludedDates String?

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  completions TodoCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TodoCompletion {
  id          String   @id @default(cuid())

  todo        Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  todoId      String

  targetDate  DateTime

  createdAt   DateTime @default(now())

  @@unique([todoId, targetDate])
}

model DailyTask {
  id        String   @id @default(cuid())
  text      String
  isDone    Boolean  @default(false)
  date      DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyMemo {
  id        String   @id @default(cuid())
  content   String
  date      DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("todo") // todo, in_progress, done
  startAt     DateTime?
  endAt       DateTime?

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String

  assignees   User[]   @relation("ProjectAssignees")

  tasks       ProjectTask[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo")
  priority    String?   @default("medium")

  startAt     DateTime?
  endAt       DateTime?

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  assignees   User[]    @relation("TaskAssignees")

  blockedBy   ProjectTask[] @relation("TaskDependencies")
  blocking    ProjectTask[] @relation("TaskDependencies")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Challenge {
  id            String    @id @default(cuid())
  title         String
  description   String?
  startAt       DateTime  // 시작 날짜 (이 날짜를 기준으로 n일마다 반복을 계산)
  interval      Int       @default(1) // n일마다 (1 = 매일, 2 = 2일마다, 3 = 3일마다...)
  targetCount   Int?      // 목표 횟수 (null이면 무기한 반복, 100이면 100번 달성 시 종료)

  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId    String

  completions   ChallengeCompletion[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ChallengeCompletion {
  id          String   @id @default(cuid())

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String

  targetDate  DateTime // 챌린지를 달성한 해당 날짜

  createdAt   DateTime @default(now())

  // 동일한 챌린지를 같은 날짜에 여러 번 달성할 수 없도록 유니크 제약
  @@unique([challengeId, targetDate])
}