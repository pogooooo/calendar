generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

generator devClient {
  provider = "prisma-client-js"
  output   = "../src/generated/dev-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String?         @unique
  emailVerified DateTime?
  password      String?
  image         String?
  /// 비밀번호가 바뀌거나(변경·재설정) 구글이 미인증 계정을 넘겨받으면 하나 오른다 — 그 전에 내준 홈 위젯 열쇠를 끊는다 (src/lib/jwt.ts)
  tokenVersion  Int             @default(0)
  accounts      Account[]
  refreshToken  RefreshToken[]

  createdCategories Category[] @relation("CreatedCategories")
  participatingCategories Category[] @relation("CategoryParticipants")
  settings                UserSettings?

  dailyTasks  DailyTask[]
  dailyMemos  DailyMemo[]
  anniversaries Anniversary[]

  assignedProjects Project[]     @relation("ProjectAssignees")
  assignedTasks    ProjectTask[] @relation("TaskAssignees")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model UserSettings {
  id    String @id @default(cuid())
  theme String @default("celestial")

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model Anniversary {
  id        String   @id @default(cuid())
  title     String
  month     Int
  day       Int
  icon      String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model RefreshToken {
  id           String   @id @default(cuid())
  /// 토큰 원문이 아니라 SHA-256 해시 — DB 가 새도 그것만으로는 로그인할 수 없다 (src/lib/jwt.ts 의 refreshKey).
  /// 2026-10-15 이전에 만든 줄은 원문이 남아 있다가 쓰일 때·만료될 때 사라진다
  Token        String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id            String  @id @default(cuid())
  name          String
  color         String
  description   String?

  creator       User    @relation("CreatedCategories", fields: [creatorId], references: [id])
  creatorId     String
  creatorName   String

  participants  User[] @relation("CategoryParticipants")
  /// 아직 수락하지 않은 초대 — 이메일로 걸고, 그 주소로 가입·인증한 사람이 수락해야 참여자가 된다
  invites       CategoryInvite[]

  todos Todo[]
  projects Project[]
  challenges Challenge[]
}

model Todo {
  id        String    @id @default(cuid())
  title     String
  memo      String?
  startAt   DateTime?
  endAt     DateTime?
  isAllDay  Boolean   @default(false)
  location  String?
  repeat    Int       @default(0)

  repeatEndDate DateTime?
  repeatCount   Int?
  excludedDates String?

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  completions TodoCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TodoCompletion {
  id          String   @id @default(cuid())

  todo        Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  todoId      String

  targetDate  DateTime

  createdAt   DateTime @default(now())

  @@unique([todoId, targetDate])
}

model DailyTask {
  id        String   @id @default(cuid())
  text      String
  isDone    Boolean  @default(false)
  date      DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyMemo {
  id        String   @id @default(cuid())
  content   String
  date      DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("todo") // todo, in_progress, done
  startAt     DateTime?
  endAt       DateTime?

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String

  assignees   User[]   @relation("ProjectAssignees")

  tasks       ProjectTask[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo")
  priority    String?   @default("medium")

  startAt     DateTime?
  endAt       DateTime?
  /// 시각 없이 날짜만인 할 일. 예전 것은 모두 날짜만 고를 수 있었으므로 기본이 true
  isAllDay    Boolean   @default(true)

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  assignees   User[]    @relation("TaskAssignees")

  blockedBy   ProjectTask[] @relation("TaskDependencies")
  blocking    ProjectTask[] @relation("TaskDependencies")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Challenge {
  id            String    @id @default(cuid())
  title         String
  description   String?
  startAt       DateTime  // 시작 날짜 (이 날짜를 기준으로 n일마다 반복을 계산)
  interval      Int       @default(1) // n일마다 (1 = 매일, 2 = 2일마다, 3 = 3일마다...)
  targetCount   Int?      // 목표 횟수 (null이면 무기한 반복, 100이면 100번 달성 시 종료)

  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId    String

  completions   ChallengeCompletion[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ChallengeCompletion {
  id          String   @id @default(cuid())

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String

  targetDate  DateTime // 챌린지를 달성한 해당 날짜

  createdAt   DateTime @default(now())

  // 동일한 챌린지를 같은 날짜에 여러 번 달성할 수 없도록 유니크 제약
  @@unique([challengeId, targetDate])
}

/// 카테고리 초대 — 받는 사람이 수락하기 전까지는 참여자가 아니다(이름·이메일도 서로 보이지 않는다).
/// 가입하지 않은 주소에도 똑같이 걸려 가입 여부가 드러나지 않는다. 30일이 지나면 지운다 (src/app/api/category/invite)
model CategoryInvite {
  id         String   @id @default(cuid())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  /// 소문자로 다듬은 받는 사람 주소
  email      String
  inviterId  String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([categoryId, email])
  @@index([email])
  @@index([expiresAt])
}

/// 로그인·가입·비밀번호 확인 같은 시도의 횟수. 워커 인스턴스마다 따로 세던 메모리 대신 여기 둔다 — 모든 인스턴스가 같이 본다
/// (예전엔 요청이 여러 인스턴스로 흩어져 막아야 할 만큼 세지 못했다). src/lib/rateLimiter.ts
model RateLimit {
  key          String    @id
  count        Int
  firstAt      DateTime
  blockedUntil DateTime?
  expiresAt    DateTime

  @@index([expiresAt])
}
