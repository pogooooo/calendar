# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/out-desktop/
/.open-next/
/dl.html
/tail*.log
/d1-schema.sql

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/

# Tauri
/src-tauri/target/
/src-tauri/gen/

# Cloudflare 로컬 개발 상태 (miniflare)
/.wrangler/

# Claude Code 작업 공간
/.claude/worktrees/

# wrangler 로컬 환경변수 (시크릿 포함)
.dev.vars
.dev.vars.*

# 로컬에서 구운 APK (릴리스는 GitHub Actions 가 만든다)
*.apk
*.apk.idsig

# productivity 플러그인이 만드는 대시보드 (프로젝트 코드가 아니다)
dashboard.html
