# 안드로이드 업로드 서명 열쇠. 이 파일을 keystore.properties 로 복사해 채운다.
# (keystore.properties 는 .gitignore 에 있어 git 에 올라가지 않는다)
#
# 열쇠 만들기 — 한 번만:
#   keytool -genkeypair -v -keystore C:/Users/pogo/tools/cronos-upload.keystore ^
#           -alias cronos-upload -keyalg RSA -keysize 2048 -validity 10000
#   (keytool 은 C:/Users/pogo/tools/jdk-17.0.20.1+1/bin 에 있다)
#
# 이 열쇠 파일과 비밀번호는 잃어버리면 안 된다 — Play 앱 서명을 쓰면 재발급은 가능하지만 번거롭다.

storeFile=C:/Users/pogo/tools/cronos-upload.keystore
storePassword=
keyAlias=cronos-upload
keyPassword=
