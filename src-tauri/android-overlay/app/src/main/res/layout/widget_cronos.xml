<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 위젯 틀. 제목 한 줄 + 줄 여섯(넘치면 숨김) + 빈 문구. 내용은 CronosWidgetProvider 가 채운다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#D4AF37"
        android:textSize="11sp"
        android:letterSpacing="0.18"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingBottom="6dp" />

    <!-- 제목 밑줄. RemoteViews 는 맨 android.view.View 를 못 부풀린다("Class not allowed to be inflated") — 그래서 ImageView 다. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4DD4AF37"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row1_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="9dp"
            android:src="@drawable/widget_dot"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/row1_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#ECE6D6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row1_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#9B947F"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row2_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="9dp"
            android:src="@drawable/widget_dot"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/row2_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#ECE6D6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row2_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#9B947F"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row3_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="9dp"
            android:src="@drawable/widget_dot"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/row3_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#ECE6D6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row3_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#9B947F"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row4_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="9dp"
            android:src="@drawable/widget_dot"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/row4_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#ECE6D6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row4_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#9B947F"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row5_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="9dp"
            android:src="@drawable/widget_dot"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/row5_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#ECE6D6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row5_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#9B947F"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/row6_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="9dp"
            android:src="@drawable/widget_dot"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/row6_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#ECE6D6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row6_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#9B947F"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:textColor="#9B947F"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
