{
  "productName": "CRONOS",
  "version": "0.1.4",
  "identifier": "com.cronos.todoapp",
  "build": {
    "beforeDevCommand": "npm run next:dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../out-desktop"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "CRONOS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pogooooo/calendar/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFOUYwNEM4NTMwOUNDNwpSV1RIbkRDRlRQRHBDYjlvSEwrNGRha0todmxKVk9YaEhud0ttYzZ1RjB5T0NwbWwzSFJhR0xRWgo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
